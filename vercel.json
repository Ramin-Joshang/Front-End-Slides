{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{projector-theme.css,images/**,*.html}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/audience.html" },
    { "source": "/audience", "destination": "/audience.html" },
    { "source": "/presenter", "destination": "/presenter.html" },
    { "source": "/projector-theme.css", "destination": "/projector-theme.css" },
    { "source": "/images/(.*)", "destination": "/images/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
